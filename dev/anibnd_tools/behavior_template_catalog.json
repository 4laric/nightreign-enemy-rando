{
  "_meta": {
    "purpose": "Behavior-template catalog for NR chrs. Derived from chr-id-normalized MD5 hash of the Behaviors/{cp}.hkx file inside each chr's .behbnd archive. Chrs sharing a template have byte-identical AI state machines (modulo the chr_id substring).",
    "methodology": "For each behbnd, extract Behaviors/{cp}.hkx, replace the chr_number (e.g. \"4810\") with \"XXXX\" placeholder, hash with MD5, truncate to 10 chars. Chrs with the same hash share the same behavior template.",
    "corpus_coverage": "459 chrs from c0xxx-c9xxx ranges. Behbnds extracted via Yabber + BND4 parser at dev/anibnd_tools/bnd4_reader.py.",
    "version": "v0.24.84",
    "archetype_taxonomy_note": "Template membership is the primary signal. Archetype labels are inferred from named members + game knowledge. Templates with 1-2 members are typically bespoke single bosses with custom AI (e.g., named remembrance bosses). Templates with 10+ members are shared archetypes."
  },
  "archetypes": {
    "c880d10143": {
      "archetype": "emerge_from_ground",
      "description": "Sit-idle-then-rise on encounter trigger. Confirmed for: Land Squirt, Miranda, Erdtree Avatar (via cc910d90c1), Slugs, Crabs (per user), Octopi, Scarabs, Putrid Flesh, Snail, Grafted Scion, Tibia Mariner, Graven School.",
      "gate": "V3_NO_EMERGE_SLOTS \u2014 ban at elevated/rampart/rooftop slots without subsurface terrain."
    },
    "cc910d90c1": {
      "archetype": "emerge_from_ground_avatar",
      "description": "Erdtree Avatar variant cluster (c4810, c4811 only). Separate template but same failure mode as c880d10143.",
      "gate": "Same as emerge_from_ground."
    },
    "472b076cb7": {
      "archetype": "humanoid_mob_standard",
      "description": "45 chrs, mostly mid-size humanoids. Skeletons, Misbegotten, Albinauric, Sanguine Noble, Dominula Celebrant, Grave Warden Duelist, Exile Soldier types. Walk-and-attack mobs with normal locomotion movesets.",
      "gate": "No gate needed \u2014 generally safe to place anywhere."
    },
    "f847bca359": {
      "archetype": "humanoid_mob_combatant",
      "description": "41 chrs, mid-size humanoids with bespoke movesets. Black Knife Assassin, Crucible Knight, Imp, Skeleton (Spear), Nomadic Merchant, Frenzied Nomad. Standing combatants with full locomotion.",
      "gate": "No gate needed."
    },
    "0208788a2b": {
      "archetype": "quadruped_dog",
      "description": "12 chrs, all canine quadrupeds. Stray, Large Stray, Mushroom Dog, Bloodbane Stray, Rotten Stray.",
      "gate": "No gate identified yet."
    },
    "aba5052255": {
      "archetype": "flying_dragon",
      "description": "9 chrs. Named member: c4503 Borealis (GIGA). Other 8 unnamed \u2014 likely other flying dragons.",
      "gate": "CANDIDATE for fly_in gate when nr_no_fly_slots.json is built. Likely fails at low-ceiling indoor slots."
    },
    "8d23a04f8f": {
      "archetype": "mid_tier_humanoid",
      "description": "Night's Cavalry, Ancestral Follower, Fire Prelate, Omenkiller, Fallen Hawks Soldier. Larger humanoid/quadruped combatants.",
      "gate": "No gate identified."
    },
    "127dfb6c93": {
      "archetype": "large_humanoid_boss",
      "description": "Omen, Wormface, Gargoyle, Gravebird, Ancestral Follower Shaman. Larger boss-tier with bespoke movesets. WORMFACE here is interesting \u2014 it's a canonical ER ground-eruption enemy but uses a different behavior template than c880d10143, meaning its emerge mechanism is different.",
      "gate": "Wormface may need separate emerge handling. Other members likely scripted_intro."
    },
    "b71ec383a8": {
      "archetype": "humanoid_combatant_specialty",
      "description": "8 humanoids: Elemer of the Briar, Crystalian, Cleanrot Knight, Fire Monk, Disciple of Rot, Guilty. Bespoke movesets for elemental/specialty fighters.",
      "gate": "No gate identified."
    },
    "b7316003d9": {
      "archetype": "horse_quadruped",
      "description": "5 horses including c4363 Lordsworn Knight's Horse (Night Boss). Quadruped riders.",
      "gate": "No gate identified."
    },
    "07f06730ab": {
      "archetype": "demi_human",
      "description": "c4100 Demi-Human, c4110 Demi-Human Shaman, 2 unnamed. Small humanoid creatures.",
      "gate": "No gate identified."
    },
    "27dffb5d2a": {
      "archetype": "fingercreeper",
      "description": "c4240 Fingercreeper, c4241 Giant Fingercreeper, 2 unnamed. SEPARATE from c880d10143 emerge cluster \u2014 Fingercreepers might have their own emerge subtype.",
      "gate": "CANDIDATE for emerge_from_ground secondary \u2014 needs playtest validation."
    },
    "0fb16cc66a": {
      "archetype": "knight_humanoid",
      "description": "Cuckoo Knight, Leyndell Knight, Inquisitor (Staff), 1 unnamed. Standard knight class.",
      "gate": "No gate identified."
    },
    "b6e4dd63f3": {
      "archetype": "royal_revenant",
      "description": "c4020/c4021 Royal Revenant + 1 unnamed. Specific creature family.",
      "gate": "No gate identified."
    },
    "9a9fb2902a": {
      "archetype": "ancient_dragon",
      "description": "c4510 Ancient Dragon (GIGA) + 2 unnamed. Possibly other major dragons.",
      "gate": "May share fly_in concerns when nr_no_fly_slots.json built."
    },
    "3afddc5178": {
      "archetype": "troll_xxl",
      "description": "3 XXL Trolls: Troll Knight, Snowfield Troll + 1 unnamed. Large-bodied bipeds.",
      "gate": "CANDIDATE for \"large_ground\" gate \u2014 Trolls may fail at narrow indoor slots."
    },
    "7e687ef779": {
      "archetype": "dlc_special",
      "description": "3 DLC-tier specials: Libra family, Smelter Demon. Bespoke bosses.",
      "gate": "No gate identified."
    }
